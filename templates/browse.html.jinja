<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Page Title</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Fruktur&display=swap');

    .fruktur-regular {
        font-family: "Fruktur", system-ui;
        font-weight: 400;
        font-style: normal;
    }
</style>
</head>
<body class = " flex flex-col justify-center  gap-2 bg-linear-to-r from-gray-400 to-stone-800">
{% include "components/navbar.html.jinja" %}
 <h1 class= "text-5xl text-white text-center text-shadow-lg fruktur-regular ml-40 mr-40 pt-5 pb-5">
 BROWSE PRODUCTS
 </h1>
<main class =" grid grid-cols-3 gap-2 ml-3 bg-stone-300 p-2">
    {% for x in products %}
        <a href="/product/{{ x['ID']}}" class="grid justify-center text-center text-stone-700 text-shadow-lg shadow-md bg-white">
            <img class="h-50 item-center mx-auto mt-8" src="{{ x['Image'] }}"> <br>
            {{x ["Name"]}}<br>
            ${{x ["Price"]}}<br>
            {{x["Brand"]}}<br>
            {{x["Size"]}}<br>
            {{x["Category"]}}
        </a>
    {%endfor%}
</main>
 

 
</body>
</html>