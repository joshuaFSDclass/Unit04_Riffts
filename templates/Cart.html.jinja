<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Page Title</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
{% include "components/navbar.html.jinja" %}
<h1 class =" ml-135 text-8xl m-8 text-center bg-gray-300 shadow-md shadow-gray-400 w-100 text-white text-shadow-lg" >Cart</h1>

<main class ="flex gap-50">
    <div class="ml-40 rounded m-4 p-2 rounded border-1 border-black shadow-black p-20 border-b pb-6 mb-6">
        {%for x in cart%}
            <a href="/cart/{{ x['ID']}}" class="grid-cols cols-4 gap-4 justify-center">
                <img class="h-20 mx-auto mt-4 h-85 w-85 " src="{{ x['Image'] }}"> <br>
                <p>{{x ["Name"]}}</p>
                <p>${{x ["Price"] * x["Quantity"]}}</p>
               
            </a>
            <div class = "rounded border-1 bordder-black bg-gray-200">
                <form class=" shadow-gray-700 p-4 " method = "post" action = "/cart/{{x['ProductID']}}/update">
                    <input class = "p-2 bg-white w-14" type = "number" name = "qty" value="{{x ['Quantity']}}">
                    <button class = "p-2 bg-gray-300 shadow-black text-shadow-md text-white" type="submit">Update</button>
                </form>
                <form class=" shadow-gray-700 p-4" method = "post" action ="/cart/{{x['ProductID']}}/remove" >
                    <button class = "p-2 bg-gray-300 shadow-black text-shadow-md text-red-400" type="submit">Remove</button>
                </form>
            </div>
        {%endfor%}
    </div>

    <div class="border border-gray-800 shadow-gray-md rounded justify-end mt-4">
        <h1 class="text-4xl m-4 "> Order Summary </h1>
        <h2 class="mr-100 p-4">Total cost: ${{total}} </h2>
    </div>
</main>


</body>

</html>